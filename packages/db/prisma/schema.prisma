generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocKind {
  article
  reference
  note
}

enum DocLayoutMode {
  sidebar
  contentOnly
}

enum DocAccessRole {
  guest
  pro
  private
}

enum AccessSessionRole {
  owner
  pro
}

enum AccessGrantType {
  invitation
  sharedCode
}

enum AccessPrincipalType {
  invited
  anonymous
}

enum DocStatus {
  draft
  published
  archived
}

enum DocsPublicationEventType {
  published
  replaced
}

enum DocsCollectionItemType {
  article
  folder
}

/// @deprecated Legacy content ownership only. Authentication uses OwnerAccount / AccessPrincipal.
/// Retained for existing DocsDocument / DocsCollection foreign keys until ownership migration.
model User {
  id          Int              @id @default(autoincrement())
  username    String           @unique
  role        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  documents   DocsDocument[]
  collections DocsCollection[]

  @@map("users")
}

model AccessPrincipal {
  id        String              @id @default(cuid())
  type      AccessPrincipalType
  label     String
  expiresAt DateTime?
  revokedAt DateTime?
  grants    AccessGrant[]       @relation("AccessPrincipalGrants")
  sessions  AccessSession[]
  redemptions ProRedemption[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([type, revokedAt])
  @@index([expiresAt])
  @@map("access_principals")
}

model AccessGrant {
  id             String           @id @default(cuid())
  type           AccessGrantType
  label          String
  credentialHash String           @unique
  mode           String?
  codeHint       String?
  redeemExpiresAt DateTime?
  entitlementSeconds Int?
  maxRedemptions Int?
  redeemedCount  Int              @default(0)
  redemptions    ProRedemption[]
  principalId    String?
  principal      AccessPrincipal? @relation("AccessPrincipalGrants", fields: [principalId], references: [id], onDelete: Restrict)
  expiresAt      DateTime?
  revokedAt      DateTime?
  sessions       AccessSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([type, revokedAt])
  @@index([principalId])
  @@index([expiresAt])
  @@map("access_grants")
}

model AccessSession {
  id          String            @id @default(cuid())
  role        AccessSessionRole
  tokenHash   String            @unique
  principalId String?
  principal   AccessPrincipal?  @relation(fields: [principalId], references: [id], onDelete: Restrict)
  grantId     String?
  grant       AccessGrant?      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  ownerAccountId String?
  ownerAccount OwnerAccount? @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  credentialVersion Int?
  authenticatedAt DateTime?
  deviceId String?
  device OwnerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceLabel String?
  createdAt   DateTime          @default(now())

  @@index([role, expiresAt])
  @@index([principalId])
  @@index([grantId])
  @@map("access_sessions")
}

// Owner authentication is separate from content authors and cannot be publicly registered.
model OwnerAccount {
  id String @id @default("owner")
  username String @unique
  passwordHash String
  totpCiphertext String?
  totpLastStep Int @default(-1)
  credentialVersion Int @default(1)
  sessions AccessSession[]
  devices OwnerDevice[]
  challenges OwnerChallenge[]
  permits OwnerPermit[]
  recoveryCodes OwnerRecoveryCode[]
  agentDevices AgentDevice[]
  syncJobs SyncJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("owner_accounts")
}

// Independent high-entropy upload credentials; never an Owner browser session.
model AgentDevice {
  syncJobs SyncJob[]
  id String @id @default(uuid())
  ownerAccountId String
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  name String
  tokenHash String @unique
  tokenHint String
  credentialVersion Int @default(1)
  allowedSources String[]
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  rotatedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([ownerAccountId, revokedAt])
  @@map("agent_devices")
}

model OwnerChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  ownerAccountId String
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  credentialVersion Int
  stage String
  needsApproval Boolean
  pendingTotpCiphertext String?
  reauthSessionId String?
  deviceId String?
  deviceLabel String
  networkHash String
  failures Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  permits OwnerPermit[]
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@map("owner_challenges")
}

model OwnerPermit {
  id String @id @default(cuid())
  ownerAccountId String
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  credentialVersion Int
  purpose String
  codeHash String @unique
  codeHint String
  challengeId String?
  challenge OwnerChallenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([purpose, expiresAt])
  @@map("owner_permits")
}

model OwnerDevice {
  id String @id @default(cuid())
  ownerAccountId String
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  credentialVersion Int
  tokenHash String @unique
  label String
  networkHash String
  expiresAt DateTime
  revokedAt DateTime?
  sessions AccessSession[]
  createdAt DateTime @default(now())
  @@map("owner_devices")
}

model OwnerRecoveryCode {
  id String @id @default(cuid())
  ownerAccountId String
  ownerAccount OwnerAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  codeHash String @unique
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@map("owner_recovery_codes")
}

model ProRedemption {
  id String @id @default(cuid())
  grantId String
  grant AccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  deviceHash String
  principalId String
  principal AccessPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([grantId, deviceHash])
  @@map("pro_redemptions")
}

model AuthRateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("auth_rate_buckets")
}

// Audit payloads contain identifiers and outcomes, never credentials or cookie values.
model SecurityAudit {
  id String @id @default(cuid())
  actorId String?
  sessionId String?
  action String
  targetId String?
  result String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("security_audits")
}

model DocsDocument {
  id             Int                  @id @default(autoincrement())
  documentKey    String?              @unique
  kind           DocKind              @default(article)
  layoutMode     DocLayoutMode        @default(contentOnly)
  accessRole     DocAccessRole        @default(guest)
  isListed       Boolean              @default(true)
  createdById    Int?
  createdBy      User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  locales        DocsDocumentLocale[]
  collectionItem DocsCollectionItem?
  publicationEvents DocsPublicationEvent[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([kind])
  @@index([layoutMode])
  @@index([accessRole])
  @@index([isListed])
  @@map("docs_documents")
}

model DocsPublicationEvent {
  id           Int                      @id @default(autoincrement())
  documentId   Int
  document     DocsDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type         DocsPublicationEventType
  locale       String?
  occurredAt   DateTime
  writingUnits Int
  createdAt    DateTime                 @default(now())

  @@index([occurredAt])
  @@index([documentId, occurredAt])
  @@map("docs_publication_events")
}

model DocsImportConfirmation {
  draftId      String   @id
  documentId   Int
  redirectPath String
  committedAt  DateTime @default(now())

  @@map("docs_import_confirmations")
}

model DocsDocumentLocale {
  id             Int          @id @default(autoincrement())
  documentId     Int
  document       DocsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  locale         String
  slug           String
  eyebrow        String?
  title          String
  summary        String?
  status         DocStatus    @default(draft)
  publishedAt    DateTime?
  bodyJson       Json
  sidebarJson    Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([documentId, locale])
  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@map("docs_document_locales")
}

model DocsCollection {
  id            Int                    @id @default(autoincrement())
  collectionKey String?                @unique
  accessRole    DocAccessRole          @default(guest)
  createdById   Int?
  createdBy     User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  locales       DocsCollectionLocale[]
  items         DocsCollectionItem[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([accessRole])
  @@map("docs_collections")
}

model DocsCollectionLocale {
  id             Int            @id @default(autoincrement())
  collectionId   Int
  collection     DocsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale         String
  slug           String
  eyebrow        String?
  title          String
  summary        String?
  status         DocStatus      @default(draft)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([collectionId, locale])
  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@map("docs_collection_locales")
}

model DocsCollectionItem {
  id           Int                    @id @default(autoincrement())
  collectionId Int
  documentId   Int?                   @unique
  parentId     Int?
  type         DocsCollectionItemType @default(article)
  nodeKey      String
  isActive     Boolean                @default(true)
  position     Int
  collection   DocsCollection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  document     DocsDocument?          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent       DocsCollectionItem?    @relation("DocsCollectionItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocsCollectionItem[]   @relation("DocsCollectionItemTree")
  locales      DocsCollectionItemLocale[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([collectionId, nodeKey])
  @@unique([collectionId, documentId])
  @@index([collectionId, parentId, position])
  @@map("docs_collection_items")
}

model DocsCollectionItemLocale {
  id       Int                 @id @default(autoincrement())
  itemId   Int
  locale   String
  label    String
  item     DocsCollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([itemId, locale])
  @@index([locale])
  @@map("docs_collection_item_locales")
}

/* 音乐曲目 / 公开内容，不做 access 分级。
   trackKey = 内容身份，清单显式提供，不从文件名或哈希推导。
   audioUrl = 当前发布位置，只存站点 URL，不存本机路径。
   contentHash / mimeType / fileSize 描述当前文件，供导入校验。
   contentHash 唯一：一段字节一行，旧行为 NULL，可重复。
   position 允许重复，排序固定为 position ASC, id ASC。 */
model MusicTrack {
  id              String    @id @default(cuid())
  trackKey        String    @unique
  title           String
  artist          String?
  audioUrl        String
  contentHash     String?   @unique
  mimeType        String?
  fileSize        Int?
  durationSeconds Int?
  publishedAt     DateTime?
  position        Int
  isActive        Boolean   @default(true)
  libraryItems    MusicLibraryItem[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, position])
  @@map("music_tracks")
}

/* 曲库 / 只是标签：改名与重新分组都不动曲目的 trackKey 与媒体。
   key = 对外身份，清单提供；position 只决定曲库自身顺序。
   库内曲目顺序复用曲目自己的 position。
   清单未声明的曲库停用而非删除，列表按 isActive 过滤。 */
model MusicLibrary {
  id        String             @id @default(cuid())
  key       String             @unique
  title     String
  position  Int
  isActive  Boolean            @default(true)
  items     MusicLibraryItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive, position])
  @@map("music_libraries")
}

// 成员关系 / 清单是权威：每次导入整体重写，只有 createdAt
// 一首可属多库，故用中间表
model MusicLibraryItem {
  id        String       @id @default(cuid())
  libraryId String
  trackId   String
  library   MusicLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  track     MusicTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([libraryId, trackId])
  @@index([trackId])
  @@map("music_library_items")
}

/* 路线图与规划图存储模型：支持多项目与多看板，各看板持有独立的阶段状态列映射。
   - nameEn / nameZh 成对存储，由 domain 校验层保障双语对等完整性。
   - position 字段控制看板切换器、列以及条目的展示顺序。
   - detailEn / detailZh 支持富文本详情，必须成对写入或成对清空。
   - votes / comments 为保留字段，当前业务模型与交互层零暴露。 */
enum RoadmapStatus {
  reviewing
  unstarted
  active
  completed
  canceled
}

enum RoadmapEntryType {
  feature
  improvement
  maintenance
}

enum RoadmapEntryPriority {
  high
  middle
  low
  none
}

model Roadmap {
  id        String          @id @default(cuid())
  key       String          @unique
  nameEn    String
  nameZh    String
  position  Int
  projectId String?
  project   RoadmapProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  columns   RoadmapColumn[]
  entries   RoadmapEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([position])
  @@index([projectId])
  @@map("roadmaps")
}

model RoadmapProject {
  id             String    @id @default(cuid())
  key            String    @unique
  nameEn         String
  nameZh         String
  position       Int
  roadmapEnabled Boolean   @default(true)
  atlasEnabled   Boolean   @default(true)
  roadmaps       Roadmap[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([position])
  @@map("roadmap_projects")
}

model RoadmapColumn {
  id       String         @id @default(cuid())
  roadmapId String
  roadmap  Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  status   RoadmapStatus
  labelEn  String
  labelZh  String
  position Int

  @@unique([roadmapId, status])
  @@index([roadmapId, position])
  @@map("roadmap_columns")
}

model RoadmapEntry {
  id        String               @id @default(cuid())
  roadmapId String
  roadmap   Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  key       String               @unique
  status    RoadmapStatus
  type      RoadmapEntryType
  priority  RoadmapEntryPriority
  titleEn   String
  titleZh   String
  summaryEn String
  summaryZh String
  votes     Int?
  comments  Int?
  position  Int
  links     RoadmapEntryLink[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  detailEn  String?
  detailZh  String?

  @@index([roadmapId, status, position])
  @@map("roadmap_entries")
}

model RoadmapEntryLink {
  id       String       @id @default(cuid())
  entryId  String
  entry    RoadmapEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  labelEn  String
  labelZh  String
  href     String
  position Int

  @@index([entryId, position])
  @@map("roadmap_entry_links")
}
model SyncJob {
  id                String   @id @default(uuid()) @db.Uuid
  ownerAccountId    String
  ownerAccount      OwnerAccount @relation(fields:[ownerAccountId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  deviceId          String
  device            AgentDevice @relation(fields:[deviceId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  activeKey         String?  @unique
  idempotencyKey    String   @db.Uuid
  status            String
  credentialVersion Int
  policyHash        String
  createdAt         DateTime @default(now())
  dispatchedAt      DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  expiresAt         DateTime
  startRevision     BigInt?
  dataRevision      BigInt?
  completionHash    String?
  result            Json?
  errorCode         String?
  @@unique([ownerAccountId,idempotencyKey],map:"sync_jobs_owner_idempotency_key")
  @@index([deviceId,createdAt],map:"sync_jobs_device_created")
  @@index([status,expiresAt],map:"sync_jobs_status_expires")
  @@map("sync_jobs")
}
