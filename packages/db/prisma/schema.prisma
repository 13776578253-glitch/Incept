generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocKind {
  article
  reference
  note
}

enum DocLayoutMode {
  sidebar
  contentOnly
}

enum DocAccessRole {
  guest
  member
  pro
}

enum DocStatus {
  draft
  published
  archived
}

model User {
  id        Int            @id @default(autoincrement())
  username  String         @unique
  role      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  documents DocsDocument[]
  collections DocsCollection[]

  @@map("users")
}

model DocsDocument {
  id          Int                  @id @default(autoincrement())
  documentKey String?              @unique
  kind        DocKind              @default(article)
  layoutMode  DocLayoutMode        @default(contentOnly)
  accessRole  DocAccessRole        @default(guest)
  createdById Int?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  locales     DocsDocumentLocale[]
  collectionItem DocsCollectionItem?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([kind])
  @@index([layoutMode])
  @@index([accessRole])
  @@map("docs_documents")
}

model DocsDocumentLocale {
  id             Int          @id @default(autoincrement())
  documentId     Int
  document       DocsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  locale         String
  slug           String
  eyebrow        String?
  title          String
  summary        String?
  status         DocStatus    @default(draft)
  publishedAt    DateTime?
  bodyJson       Json
  sidebarJson    Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([documentId, locale])
  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@map("docs_document_locales")
}

model DocsCollection {
  id          Int                    @id @default(autoincrement())
  accessRole  DocAccessRole          @default(guest)
  createdById Int?
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  locales     DocsCollectionLocale[]
  items       DocsCollectionItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([accessRole])
  @@map("docs_collections")
}

model DocsCollectionLocale {
  id             Int            @id @default(autoincrement())
  collectionId   Int
  collection     DocsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale         String
  slug           String
  eyebrow        String?
  title          String
  summary        String?
  status         DocStatus      @default(draft)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([collectionId, locale])
  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@map("docs_collection_locales")
}

model DocsCollectionItem {
  id           Int            @id @default(autoincrement())
  collectionId Int
  documentId   Int            @unique
  position     Int
  collection   DocsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  document     DocsDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([collectionId, position])
  @@unique([collectionId, documentId])
  @@index([collectionId])
  @@map("docs_collection_items")
}
