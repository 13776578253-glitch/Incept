{
  "name": "@incept/dashboard",
  "private": true,
  "type": "module",
  "exports": {
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./endpoints": {
      "types": "./src/endpoints.ts",
      "default": "./src/endpoints.ts"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "default": "./src/domain/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./messages/en": "./src/messages/en.json",
    "./messages/zh": "./src/messages/zh.json"
  },
  "scripts": {
    "build:runtime": "node tools/build-runtime.mjs",
    "build:sync-maintenance": "node tools/build-sync-maintenance.mjs",
    "pretest": "node tools/build-runtime.mjs",
    "build:tools": "node tools/build-transfer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": "^16.2.0",
    "next-intl": "^4.8.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "jsdom": "^30.1.0",
    "next": "16.4.3",
    "next-intl": "4.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "ccusage": "20.0.30",
    "server-only": "0.0.1"
  }
}
