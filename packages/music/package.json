{
  "name": "@incept/music",
  "private": true,
  "type": "module",
  "exports": {
    "./endpoints": {
      "types": "./src/endpoints.ts",
      "default": "./src/endpoints.ts"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "default": "./src/domain/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    },
    "./application": {
      "types": "./src/application/index.ts",
      "default": "./src/application/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/setup": {
      "types": "./src/testing/setup.ts",
      "default": "./src/testing/setup.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude src/__tests__/cli-smoke.test.ts",
    "test:cli": "vitest run src/__tests__/cli-smoke.test.ts"
  },
  "dependencies": {
    "@incept/db": "workspace:*",
    "@incept/music-player-core": "workspace:*",
    "music-metadata": "^11.15.0"
  },
