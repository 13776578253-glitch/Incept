{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": [
      "../packages/db/node_modules/@types",
      "../packages/roadmap/node_modules/@types",
      "../node_modules/@types"
    ],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.mts"]
}
