// Current Prisma database schema as of 2026-11-04.
// Paste this file into https://dbdiagram.io to inspect the current model.
//
// Source of truth: packages/db/prisma/schema.prisma plus the applied migrations
// under packages/db/prisma/migrations/ (21 migrations, last: 20261014213000_about_public_access).
// Total tables: 28, foreign keys: 27, enums: 12.
//
// This snapshot closes the gap left by 2026-09-23-current-database-schema.dbml,
// incorporating roadmap modules, import confirmations, and owner authentication & security infrastructure.

Enum DocKind {
  article
  reference
  note
}

Enum DocLayoutMode {
  sidebar
  contentOnly
}

Enum DocAccessRole {
  guest
  pro
  private
}

Enum AccessSessionRole {
  owner
  pro
}

Enum AccessGrantType {
  invitation
  sharedCode
}

Enum AccessPrincipalType {
  invited
  anonymous
}

Enum DocStatus {
  draft
  published
  archived
}

Enum DocsPublicationEventType {
  published
  replaced
}

Enum DocsCollectionItemType {
  article
  folder
}

Enum RoadmapStatus {
  reviewing
  unstarted
  active
  completed
  canceled
}

Enum RoadmapEntryType {
  feature
  improvement
  maintenance
}

Enum RoadmapEntryPriority {
  high
  middle
  low
  none
}

Table users {
  id int [pk, increment]
  username varchar [not null, unique]
  role varchar [not null, note: 'Content ownership metadata; not a public account role.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table access_principals {
  id varchar [pk, note: 'CUID identity for invited or anonymous access.']
  type AccessPrincipalType [not null]
  label varchar [not null]
  expiresAt timestamp
  revokedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (type, revokedAt)
    expiresAt
  }
}

Table access_grants {
  id varchar [pk, note: 'Credential metadata; raw invitation/shared code is never stored.']
  type AccessGrantType [not null]
  label varchar [not null]
  credentialHash varchar [not null, unique]
  mode varchar [note: 'Grant mode: single (one-time) or shared (multi-seat).']
  codeHint varchar [note: 'Display hint for redemption codes.']
  redeemExpiresAt timestamp [note: 'Window deadline for grant redemption.']
  entitlementSeconds int [note: 'Duration in seconds granted upon redemption for relative-duration grants.']
  maxRedemptions int [note: 'Maximum allowed redemptions for shared code grants.']
  redeemedCount int [not null, default: 0]
  principalId varchar [note: 'Invitation points to a Principal; sharedCode may be null.']
  expiresAt timestamp [note: 'Absolute expiration date for the grant.']
  revokedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (type, revokedAt)
    principalId
    expiresAt
  }
}

Table access_sessions {
  id varchar [pk, note: 'Server-side session record for owner or pro cookie.']
  role AccessSessionRole [not null]
  tokenHash varchar [not null, unique]
  principalId varchar [note: 'Pro sessions point to a Principal; owner sessions are null.']
  grantId varchar [note: 'Pro sessions point to the Grant used for access; owner sessions are null.']
  expiresAt timestamp [note: 'Nullable since 20260721090000. Owner must set it; pro must leave it null.']
  revokedAt timestamp
  lastUsedAt timestamp
  ownerAccountId varchar [note: 'Owner sessions point to the OwnerAccount.']
  credentialVersion int [note: 'Snapshot of owner credentialVersion at session creation.']
  authenticatedAt timestamp [note: 'Timestamp when full authentication (including MFA) finished.']
  deviceId varchar [note: 'Bound trusted owner device record.']
  deviceLabel varchar [note: 'Cached device or browser label at session creation.']
  createdAt timestamp [not null]

  Indexes {
    (role, expiresAt)
    principalId
    grantId
  }
}

Table owner_accounts {
  id varchar [pk, default: 'owner', note: 'Singleton Owner account enforced by check id = owner.']
  username varchar [not null, unique]
  passwordHash varchar [not null]
  totpCiphertext varchar [note: 'Encrypted TOTP secret ciphertext.']
  totpLastStep int [not null, default: -1, note: 'Last validated TOTP time step to prevent replay attacks.']
  credentialVersion int [not null, default: 1, note: 'Monotonically increasing version; invalidates older sessions on credential change.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table owner_challenges {
  id varchar [pk, note: 'CUID identity for owner multi-step login / approval challenge.']
  tokenHash varchar [not null, unique]
  ownerAccountId varchar [not null]
  credentialVersion int [not null]
  stage varchar [not null, note: 'Current challenge stage (e.g. totp, approve).']
  needsApproval boolean [not null]
  pendingTotpCiphertext varchar
  reauthSessionId varchar
  deviceId varchar
  deviceLabel varchar [not null]
  networkHash varchar [not null]
  failures int [not null, default: 0]
  expiresAt timestamp [not null]
  consumedAt timestamp
  createdAt timestamp [not null]

  Indexes {
    expiresAt
  }
}

Table owner_permits {
  id varchar [pk, note: 'CUID identity for one-time owner action permits.']
  ownerAccountId varchar [not null]
  credentialVersion int [not null]
  purpose varchar [not null, note: 'Permit purpose (e.g. login approval, recovery).']
  codeHash varchar [not null, unique]
  codeHint varchar [not null]
  challengeId varchar
  expiresAt timestamp [not null]
  consumedAt timestamp
  revokedAt timestamp
  createdAt timestamp [not null]

  Indexes {
    (purpose, expiresAt)
  }
}

Table owner_devices {
  id varchar [pk, note: 'CUID identity for remembered owner trusted devices.']
  ownerAccountId varchar [not null]
  credentialVersion int [not null]
  tokenHash varchar [not null, unique]
  label varchar [not null]
  networkHash varchar [not null]
  expiresAt timestamp [not null]
  revokedAt timestamp
  createdAt timestamp [not null]
}

Table owner_recovery_codes {
  id varchar [pk, note: 'CUID.']
  ownerAccountId varchar [not null]
  codeHash varchar [not null, unique]
  consumedAt timestamp
  createdAt timestamp [not null]
}

Table pro_redemptions {
  id varchar [pk, note: 'CUID record of grant redemption per device.']
  grantId varchar [not null]
  deviceHash varchar [not null, note: 'Fingerprint of the redeeming device for grant deduplication.']
  principalId varchar [not null]
  createdAt timestamp [not null]

  Indexes {
    (grantId, deviceHash) [unique]
  }
}

Table auth_rate_buckets {
  key varchar [pk, note: 'Composite rate limiter key (IP/route/action).']
  count int [not null, default: 1]
  expiresAt timestamp [not null]

  Indexes {
    expiresAt
  }
}

Table security_audits {
  id varchar [pk, note: 'CUID audit event record.']
  actorId varchar [note: 'Actor identifier (sessionId, principalId, or owner). Never stores secrets.']
  sessionId varchar
  action varchar [not null]
  targetId varchar
  result varchar [not null]
  createdAt timestamp [not null]

  Indexes {
    createdAt
  }
}

Table docs_documents {
  id int [pk, increment]
  documentKey varchar [unique, note: 'Cross-locale stable article identity.']
  kind DocKind [not null, default: 'article']
  layoutMode DocLayoutMode [not null, default: 'contentOnly']
  accessRole DocAccessRole [not null, default: 'guest']
  isListed boolean [not null, default: true, note: 'False for internal Docs-backed content such as About.']
  createdById int [note: 'Importer-managed system user.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    kind
    layoutMode
    accessRole
    isListed
  }
}

Table docs_publication_events {
  id int [pk, increment]
  documentId int [not null]
  type DocsPublicationEventType [not null]
  locale varchar [note: 'Locale whose import created the event.']
  occurredAt timestamp [not null, note: 'published uses source time; replaced uses confirmation time.']
  writingUnits int [not null, note: 'Writing activity snapshot for the event.']
  createdAt timestamp [not null]

  Indexes {
    occurredAt
    (documentId, occurredAt)
  }
}

Table docs_import_confirmations {
  draftId varchar [pk, note: 'Draft identifier for the confirmed import session.']
  documentId int [not null, note: 'Target docs_documents id; non-FK reference managed by importer.']
  redirectPath varchar [not null]
  committedAt timestamp [not null]
}

Table docs_document_locales {
  id int [pk, increment]
  documentId int [not null]
  locale varchar [not null]
  slug varchar [not null]
  eyebrow varchar
  title varchar [not null]
  summary varchar
  status DocStatus [not null, default: 'draft']
  publishedAt timestamp [note: 'First-publication date; Docs Home ordering. A replace keeps it.']
  bodyJson json [not null, note: 'Structured Docs body: sections and block unions.']
  sidebarJson json
  seoTitle varchar
  seoDescription varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (documentId, locale) [unique]
    (locale, slug) [unique]
    (locale, status, publishedAt)
  }
}

Table docs_collections {
  id int [pk, increment]
  collectionKey varchar [unique, note: 'Cross-locale stable collection identity.']
  accessRole DocAccessRole [not null, default: 'guest']
  createdById int [note: 'Importer-managed system user.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    accessRole
  }
}

Table docs_collection_locales {
  id int [pk, increment]
  collectionId int [not null]
  locale varchar [not null]
  slug varchar [not null]
  eyebrow varchar
  title varchar [not null]
  summary varchar
  status DocStatus [not null, default: 'draft']
  publishedAt timestamp
  seoTitle varchar
  seoDescription varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (collectionId, locale) [unique]
    (locale, slug) [unique]
    (locale, status, publishedAt)
  }
}

Table docs_collection_items {
  id int [pk, increment]
  collectionId int [not null]
  documentId int [unique, note: 'Null for folder nodes.']
  parentId int [note: 'Self-reference; null for a root node.']
  type DocsCollectionItemType [not null, default: 'article']
  nodeKey varchar [not null, note: 'Stable navigation node identity. Shared across locales; see BACKLOG B-14.']
  isActive boolean [not null, default: true, note: 'Inactive nodes are retained but hidden after replace cleanup.']
  position int [not null, note: 'Sibling order from numbered directory prefixes. Not unique: the (collectionId, position) unique index was dropped by 20260901090000.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (collectionId, nodeKey) [unique]
    (collectionId, documentId) [unique]
    (collectionId, parentId, position)
    collectionId [note: 'Present in the database but not declared in schema.prisma; tracked as BACKLOG B-17.']
  }
}

Table docs_collection_item_locales {
  id int [pk, increment]
  itemId int [not null]
  locale varchar [not null]
  label varchar [not null, note: 'Folder display label for this locale.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (itemId, locale) [unique]
    locale
  }
}

Table music_tracks {
  id varchar [pk, note: 'CUID.']
  trackKey varchar [not null, unique, note: 'Content identity; supplied explicitly by the manifest and never derived from the file name or hash.']
  title varchar [not null]
  artist varchar
  audioUrl varchar [not null, note: 'Published site URL only (/_music-media/<sha256>.<ext>); no local absolute path is ever stored.']
  contentHash varchar [unique, note: 'One piece of content is one row. Nullable: rows imported before the column existed are exempt and never match dedup.']
  mimeType varchar
  fileSize int
  durationSeconds int [note: 'Null when the tag could not be read at import time.']
  publishedAt timestamp
  position int [not null, note: 'Ordering is position ASC, id ASC; duplicates are allowed.']
  isActive boolean [not null, default: true, note: 'Deletion deactivates; erasing a row is the deliberate per-row delete.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (isActive, position)
  }
}

Table music_libraries {
  id varchar [pk, note: 'CUID.']
  key varchar [not null, unique, note: 'Outward identity; renames and regrouping never change a track key or its media.']
  title varchar [not null]
  position int [not null, note: 'Orders the libraries themselves. Order inside a library reuses the track position.']
  isActive boolean [not null, default: true, note: 'A library missing from an authoritative manifest is deactivated, not deleted.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (isActive, position)
  }
}

Table music_library_items {
  id varchar [pk, note: 'CUID.']
  libraryId varchar [not null]
  trackId varchar [not null]
  createdAt timestamp [not null, note: 'Membership is rewritten wholesale on import; there is no updatedAt.']

  Indexes {
    (libraryId, trackId) [unique]
    trackId
  }
}

Table roadmap_projects {
  id varchar [pk, note: 'CUID.']
  key varchar [not null, unique, note: 'Unique project key / slug.']
  nameEn varchar [not null]
  nameZh varchar [not null]
  position int [not null, note: 'Project display ordering.']
  roadmapEnabled boolean [not null, default: true, note: 'Controls whether the roadmap board surface is enabled.']
  atlasEnabled boolean [not null, default: true, note: 'Controls whether the atlas surface is enabled.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    position
  }
}

Table roadmaps {
  id varchar [pk, note: 'CUID.']
  key varchar [not null, unique, note: 'Unique slug / identifier for the roadmap board.']
  nameEn varchar [not null]
  nameZh varchar [not null]
  position int [not null, note: 'Board display and switcher ordering.']
  projectId varchar [note: 'Parent roadmap_projects foreign key.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    position
    projectId
  }
}

Table roadmap_columns {
  id varchar [pk, note: 'CUID.']
  roadmapId varchar [not null]
  status RoadmapStatus [not null]
  labelEn varchar [not null]
  labelZh varchar [not null]
  position int [not null, note: 'Column display ordering within board.']

  Indexes {
    (roadmapId, status) [unique]
    (roadmapId, position)
  }
}

Table roadmap_entries {
  id varchar [pk, note: 'CUID.']
  roadmapId varchar [not null]
  key varchar [not null, unique, note: 'Unique entry key / slug.']
  status RoadmapStatus [not null]
  type RoadmapEntryType [not null]
  priority RoadmapEntryPriority [not null]
  titleEn varchar [not null]
  titleZh varchar [not null]
  summaryEn varchar [not null]
  summaryZh varchar [not null]
  votes int [note: 'Reserved field; not exposed to UI.']
  comments int [note: 'Reserved field; not exposed to UI.']
  position int [not null, note: 'Item ordering within column.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  detailEn varchar [note: 'Rich-text markdown details in English; must be paired with detailZh.']
  detailZh varchar [note: 'Rich-text markdown details in Chinese; must be paired with detailEn.']

  Indexes {
    (roadmapId, status, position)
  }
}

Table roadmap_entry_links {
  id varchar [pk, note: 'CUID.']
  entryId varchar [not null]
  labelEn varchar [not null]
  labelZh varchar [not null]
  href varchar [not null]
  position int [not null, note: 'Link ordering within entry.']

  Indexes {
    (entryId, position)
  }
}

