// SUPERSEDED — earliest v1 docs schema draft, circa the init migration (2026-05-06).
// Archived into history/dbml/ on 2026-09-23 from docs/decisions/docs-database-draft.dbml.
//
// Do NOT read this as the current model. It has only users + docs_documents +
// docs_document_locales, and its doc_access_role is guest/member/pro. The `member`
// value was replaced by pro/private in 20260720120000_add_access_control_foundation,
// and collections, access tables, docs_publication_events and all music_* tables
// postdate it.
//
// Current model: 2026-09-23-current-database-schema.dbml in this directory, and
// packages/db/prisma/schema.prisma as the source of truth.
//
// Docs database draft for Incept
// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Enum doc_kind {
  article
  reference
  note
}

Enum doc_layout_mode {
  sidebar
  content_only
}

Enum doc_access_role {
  guest
  member
  pro
}

Enum doc_status {
  draft
  published
  archived
}

Table users {
  id integer [primary key, increment]
  username varchar [not null, unique]
  role varchar [not null, note: 'App-level user role, can later map to auth/permission system']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table docs_documents {
  id integer [primary key, increment]
  kind doc_kind [not null, default: 'article']
  layout_mode doc_layout_mode [not null, default: 'content_only']
  access_role doc_access_role [not null, default: 'guest']
  created_by integer [ref: > users.id, note: 'Nullable in implementation if seed/import creates system-owned docs']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Global document entity. Stores layout and permission metadata shared across locales.'
}

Table docs_document_locales {
  id integer [primary key, increment]
  document_id integer [not null, ref: > docs_documents.id]
  locale varchar [not null, note: 'For now: en / zh']
  slug varchar [not null]
  eyebrow varchar
  title varchar [not null]
  summary text
  status doc_status [not null, default: 'draft']
  published_at timestamp
  body_json json [not null, note: 'Section and block content for the article body']
  sidebar_json json [note: 'Only used when layout_mode = sidebar']
  seo_title varchar
  seo_description text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (document_id, locale) [unique]
    (locale, slug) [unique]
    (locale, status, published_at)
  }

  Note: 'Localized content layer. One docs document can have multiple locale rows with different slug and publish state.'
}
