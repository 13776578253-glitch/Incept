// Current Prisma database schema as of 2026-07-27.
// Paste into https://dbdiagram.io to inspect the full model.

Enum DocKind {
  article
  reference
  note
}

Enum DocLayoutMode {
  sidebar
  contentOnly
}

Enum DocAccessRole {
  guest
  pro
  private
}

Enum DocStatus {
  draft
  published
  archived
}

Enum DocsPublicationEventType {
  published
  replaced
}

Enum AccessSessionRole {
  owner
  pro
}

Enum AccessGrantType {
  invitation
  sharedCode
}

Enum AccessPrincipalType {
  invited
  anonymous
}

Table users {
  id int [pk, increment]
  username varchar [not null, unique]
  role varchar [not null, note: 'Content ownership metadata only; not an authentication role.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table access_principals {
  id varchar [pk, note: 'CUID identity for invited or anonymous pro access.']
  type AccessPrincipalType [not null]
  label varchar [not null]
  expiresAt timestamp
  revokedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (type, revokedAt)
    expiresAt
  }
}

Table access_grants {
  id varchar [pk, note: 'CUID credential record.']
  type AccessGrantType [not null]
  label varchar [not null]
  credentialHash varchar [not null, unique]
  principalId varchar [note: 'Required by invitation; absent for sharedCode.']
  expiresAt timestamp
  revokedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (type, revokedAt)
    principalId
    expiresAt
  }
}

Table access_sessions {
  id varchar [pk, note: 'CUID session record.']
  role AccessSessionRole [not null]
  tokenHash varchar [not null, unique]
  principalId varchar [note: 'Owner sessions have no Principal.']
  grantId varchar [note: 'Owner sessions have no Grant.']
  expiresAt timestamp [note: 'Owner sessions use an explicit expiry; pro follows Principal and Grant state.']
  revokedAt timestamp
  lastUsedAt timestamp
  createdAt timestamp [not null]

  Indexes {
    (role, expiresAt)
    principalId
    grantId
  }
}

Table docs_documents {
  id int [pk, increment]
  documentKey varchar [unique, note: 'Cross-locale stable article identity.']
  kind DocKind [not null, default: 'article']
  layoutMode DocLayoutMode [not null, default: 'contentOnly']
  accessRole DocAccessRole [not null, default: 'guest']
  isListed boolean [not null, default: true, note: 'False for internal Docs-backed content such as About.']
  createdById int [note: 'Currently the importer-managed system user.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    kind
    layoutMode
    accessRole
    isListed
  }
}

Table docs_document_locales {
  id int [pk, increment]
  documentId int [not null]
  locale varchar [not null]
  slug varchar [not null]
  eyebrow varchar
  title varchar [not null]
  summary varchar
  status DocStatus [not null, default: 'draft']
  publishedAt timestamp
  bodyJson json [not null]
  sidebarJson json
  seoTitle varchar
  seoDescription varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (documentId, locale) [unique]
    (locale, slug) [unique]
    (locale, status, publishedAt)
  }
}

Table docs_publication_events {
  id int [pk, increment]
  documentId int [not null]
  type DocsPublicationEventType [not null]
  locale varchar [note: 'Locale whose import triggered the event.']
  occurredAt timestamp [not null, note: 'Initial publication uses source publishedAt; replace uses confirmation time.']
  writingUnits int [not null, note: 'Chinese characters plus English words at event time.']
  createdAt timestamp [not null]

  Indexes {
    occurredAt
    (documentId, occurredAt)
  }
}

Table docs_collections {
  id int [pk, increment]
  collectionKey varchar [unique, note: 'Cross-locale stable collection identity.']
  accessRole DocAccessRole [not null, default: 'guest']
  createdById int [note: 'Currently the importer-managed system user.']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    accessRole
  }
}

Table docs_collection_locales {
  id int [pk, increment]
  collectionId int [not null]
  locale varchar [not null]
  slug varchar [not null]
  eyebrow varchar
  title varchar [not null]
  summary varchar
  status DocStatus [not null, default: 'draft']
  publishedAt timestamp
  seoTitle varchar
  seoDescription varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (collectionId, locale) [unique]
    (locale, slug) [unique]
    (locale, status, publishedAt)
  }
}

Table docs_collection_items {
  id int [pk, increment]
  collectionId int [not null]
  documentId int [not null, unique]
  position int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (collectionId, position) [unique]
    (collectionId, documentId) [unique]
  }
}

Ref: access_grants.principalId > access_principals.id [delete: restrict]
Ref: access_sessions.principalId > access_principals.id [delete: restrict]
Ref: access_sessions.grantId > access_grants.id [delete: restrict]

Ref: docs_documents.createdById > users.id [delete: set null]
Ref: docs_document_locales.documentId > docs_documents.id [delete: cascade]
Ref: docs_publication_events.documentId > docs_documents.id [delete: cascade]
Ref: docs_collections.createdById > users.id [delete: set null]
Ref: docs_collection_locales.collectionId > docs_collections.id [delete: cascade]
Ref: docs_collection_items.collectionId > docs_collections.id [delete: cascade]
Ref: docs_collection_items.documentId - docs_documents.id [delete: cascade]
