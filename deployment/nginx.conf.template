# Optional non-production proxy template. Current production uses Caddy via
# deployment/compose.caddy.yml and deployment/Caddyfile; this Nginx template is
# retained only as a reviewed fallback and is not started by the production env.
map $uri $safe_uri {
  ~^/(?:en/|zh/)?settings/access/ /invitation/redacted;
  default $uri;
}
map $uri $safe_referrer_policy {
  ~^/(?:en/|zh/)?settings/access/ no-referrer;
  default same-origin;
}
log_format incept '$time_iso8601 $remote_addr $request_method $safe_uri $status $body_bytes_sent $request_time $request_id';
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# Request-level error messages may contain invitation credentials in the original URI.
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=usage:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=sync_connect:1m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=connections:10m;
limit_conn_zone $binary_remote_addr zone=sync_websocket:10m;
map $server_name $upload_key { default incept; }
limit_conn_zone $upload_key zone=uploads:10m;

server { listen 80 default_server; server_name _; access_log /var/log/nginx/access.log incept; error_log /var/log/nginx/error.log crit; return 444; }
server {
  listen 80;
  server_name ${INCEPT_DOMAIN};
  access_log /var/log/nginx/access.log incept;
  error_log /var/log/nginx/error.log crit;
  add_header Referrer-Policy $safe_referrer_policy always;
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 308 https://$host$request_uri; }
}
server { listen 443 ssl default_server; access_log /var/log/nginx/access.log incept; error_log /var/log/nginx/error.log crit; ssl_reject_handshake on; }
server {
  listen 443 ssl;
  server_name ${INCEPT_DOMAIN};
  ssl_certificate /etc/incept/tls/fullchain.pem;
  ssl_certificate_key /etc/incept/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  access_log /var/log/nginx/access.log incept;
  error_log /var/log/nginx/error.log crit;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy $safe_referrer_policy always;
  proxy_hide_header Referrer-Policy;
  client_max_body_size 1m;
  client_body_timeout 20s;
  limit_conn connections 20;
  limit_req_status 429;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Request-ID $request_id;
  proxy_http_version 1.1;
  proxy_connect_timeout 5s;
  proxy_read_timeout 100s;
  proxy_buffering off;
  location / { proxy_pass http://app:3000; }
  location ^~ /api/internal/sync/ { return 404; }
  location ^~ /rpc/ { return 404; }
  location = /healthz { return 404; }
  location = /api/sync/ws {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $sync_gateway sync-gateway:3101;
    limit_req zone=sync_connect burst=5 nodelay;
    limit_conn sync_websocket 2;
    client_max_body_size 4k;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 90s;
    proxy_send_timeout 20s;
    proxy_buffering off;
    proxy_pass http://$sync_gateway;
  }
  location ~ ^/api/(auth/owner/login|access/shared-code/redeem)$ {
    client_max_body_size 4k;
    limit_req zone=auth burst=5 nodelay;
    proxy_pass http://app:3000;
  }
  location = /api/dashboard/usage { limit_req zone=usage burst=5 nodelay; proxy_pass http://app:3000; }
  location = /api/internal/music/tracks {
    client_max_body_size 128m;
    limit_conn uploads 1;
    proxy_pass http://app:3000;
  }
  location = /api/dashboard/imports/preview {
    client_max_body_size 64m;
    limit_conn uploads 1;
    proxy_pass http://app:3000;
  }
}
