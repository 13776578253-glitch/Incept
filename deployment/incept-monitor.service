[Unit]
Description=Incept readiness, disk, backup, sync 504 and snapshot lag probe

[Service]
Type=oneshot
User=incept
Group=incept
WorkingDirectory=/srv/incept/current
EnvironmentFile=/srv/incept/.env.monitor
Environment="NODE_OPTIONS=--max-old-space-size=64 --max-semi-space-size=4"
ExecStartPre=+/usr/bin/node scripts/production-monitor-proxy-log.mjs
ExecStart=/usr/bin/node scripts/production-monitor.mjs
StandardOutput=journal
StandardError=journal
