RESTIC_REPOSITORY=rclone:gdrive:Incept-Backups
RESTIC_PASSWORD_FILE=/srv/incept/backup-secrets/restic-password
RCLONE_CONFIG=/srv/incept/backup-secrets/rclone.conf
INCEPT_BACKUP_HOST_ID=incept-production-1
INCEPT_RESTIC_BIN=/usr/bin/restic
# Extract tarballs into a fixed uncompressed staging directory so Restic CDC deduplicates SQLite & media.
INCEPT_OFFSITE_STAGE_DIR=/srv/incept/.restic-stage
# Avoid daily full repository downloads: metadata check Mon-Sat, 5% data subset check on Sunday.
INCEPT_RESTIC_CHECK_MODE=auto
INCEPT_RESTIC_CHECK_SUBSET=5%
INCEPT_RESTIC_KEEP_DAILY=30
INCEPT_RESTIC_KEEP_WEEKLY=12
INCEPT_RESTIC_KEEP_MONTHLY=24
INCEPT_OFFSITE_WARN_GIB=220
# Tune rclone for Google Drive: avoid HTTP/2 concurrency stalls and rate-limit storms.
INCEPT_RESTIC_RCLONE_CONNECTIONS=2
INCEPT_RESTIC_RCLONE_ARGS="serve restic --stdio --drive-chunk-size=32M --tpslimit=4 --fast-list"
# Optional: use a private SSH config with a pinned host key and BatchMode=yes when using sftp: repositories.
RESTIC_SFTP_COMMAND=
