INCEPT_APP_IMAGE=incept:REPLACE_WITH_VERIFIED_REVISION
INCEPT_PROXY=caddy
INCEPT_DATA_DIR=/srv/incept/shared
INCEPT_CADDY_STATE_DIR=/srv/incept/caddy
INCEPT_CERT_DIR=/srv/incept/certificates
INCEPT_ACME_DIR=/srv/incept/acme
INCEPT_DOMAIN=site.example
MIGRATION_DB_PASSWORD=
APP_DB_PASSWORD=
# Random 32-byte key encoded as 64 hex characters. Back up encrypted and off-host.
# Passwords and account records live in PostgreSQL; legacy master-secret login is retired.
INCEPT_AUTH_ENCRYPTION_KEY=
