INCEPT_APP_IMAGE=incept:REPLACE_WITH_VERIFIED_REVISION
INCEPT_PROXY=nginx
INCEPT_DATA_DIR=/srv/incept/shared
INCEPT_CADDY_STATE_DIR=/srv/incept/caddy
INCEPT_CERT_DIR=/srv/incept/certificates
INCEPT_ACME_DIR=/srv/incept/acme
INCEPT_DOMAIN=site.example
MIGRATION_DB_PASSWORD=
APP_DB_PASSWORD=
# Random 32-byte key encoded as 64 hex characters. Back up encrypted and off-host.
# Passwords and account records live in PostgreSQL; legacy master-secret login is retired.
INCEPT_AUTH_ENCRYPTION_KEY=

# Sync remains disabled/v1 until Owner approves rollout; each technical gate still applies.
INCEPT_SYNC_ENABLED=0
INCEPT_SYNC_REMOTE_ENABLED=0
INCEPT_SYNC_READ_MODE=v1
INCEPT_SYNC_DATABASE_FILE=/data/sync/v2.db
# The approved rollout creates sync-rpc.key (64-128 random hex characters) in this directory.
INCEPT_SECRET_DIR=/srv/incept/secrets
# Exactly one device UUID is permitted while sync is enabled.
INCEPT_SYNC_DEVICE_ALLOWLIST=
INCEPT_SYNC_POLL_MS=300000
