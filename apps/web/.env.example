DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incept?schema=public"

# Generate at least 32 random characters locally. Never commit the real value.
# Rotating this secret requires: pnpm auth:revoke-owner-sessions --confirm
OWNER_ACCESS_SECRET=""

# Absolute path to the untracked directory containing real .docs.md files and local media.
# Example: DOCS_CONTENT_ROOT="D:\\Incept-content"
DOCS_CONTENT_ROOT=""

# GitHub Personal Access Token for the owner-only activity page. Keep the real value in .env.local.
# It needs access to private contributions and the configured repository.
GITHUB_ACTIVITY_TOKEN=""
GITHUB_ACTIVITY_ACCOUNT="13776578253-glitch"
GITHUB_ACTIVITY_REPOSITORY="Incept"
