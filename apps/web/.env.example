DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incept?schema=public"

# Generate at least 32 random characters locally. Never commit the real value.
# Rotating this secret requires: pnpm auth:revoke-owner-sessions --confirm
OWNER_ACCESS_SECRET=""

# Absolute path to the untracked directory containing real .docs.md files and local media.
# Example: DOCS_CONTENT_ROOT="D:\\Incept-content"
DOCS_CONTENT_ROOT=""

# Absolute path to the untracked directory containing music.json and the original audio files.
# Kept outside the repository. Only the published mirror under apps/web/public/_music-media is served,
# and the database stores the site URL, never this path.
# Example: MUSIC_CONTENT_ROOT="D:\\music-push"
MUSIC_CONTENT_ROOT=""

# GitHub Personal Access Token for the owner-only activity page. Keep the real value in .env.local.
# It needs access to private contributions and the configured repository.
GITHUB_ACTIVITY_TOKEN=""
GITHUB_ACTIVITY_ACCOUNT=""
GITHUB_ACTIVITY_REPOSITORY=""
GITHUB_ACTIVITY_BOT_REPOSITORY=""

# Shared production storage. Leave blank for local defaults.
INCEPT_DOCS_MEDIA_DIR=""
INCEPT_DOCS_DRAFTS_DIR=""
INCEPT_MUSIC_MEDIA_DIR=""
INCEPT_DASHBOARD_HOME=""
INCEPT_DASHBOARD_IMPORTS_FILE=""
INCEPT_DASHBOARD_CACHE_FILE=""
