{
  "name": "incept",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=24.15.0 <25", "pnpm": "10.30.3" },
  "pnpm": { "overrides": {
    "@babel/core": "^7.29.6", "browserslist": "^4.28.7", "baseline-browser-mapping": "^2.11.0",
    "source-map-js": "^1.2.2", "@prisma/config>deepmerge-ts": "8.0.0",
    "esbuild@<0.28.1": "0.28.1"
  } },
  "scripts": {
    "dashboard:build-tools": "pnpm --filter @incept/dashboard build:tools",
    "dashboard:imports": "node packages/dashboard/dist/dashboard-data.mjs",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @incept/music typecheck && pnpm --filter @incept/db typecheck && pnpm --filter @incept/roadmap typecheck && pnpm --filter @incept/dashboard typecheck && pnpm --filter @incept/sync-agent typecheck && pnpm --filter @incept/sync-gateway typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "test:ops": "node --test scripts/production-*.test.mjs",
    "test:core": "pnpm --filter @incept/music run test:core",
    "test:web": "pnpm --filter web test",
    "test:watch:web": "pnpm --filter web test:watch",
    "music:check-core": "pnpm --filter @incept/music run test:core",
    "music:check-adapter": "pnpm --filter @incept/music test:core",
    "music:typecheck-core": "pnpm --filter @incept/music typecheck",
    "music:mock-audio": "node scripts/music-mock-audio.mjs",
    "music:manifest": "node scripts/music-manifest.mjs",
    "music:import": "node scripts/music-import.mjs",
    "music:cleanup": "node scripts/music-cleanup.mjs",
    "docs:import": "pnpm --filter @incept/db exec tsx ../../scripts/docs-import.mjs",
    "roadmap:seed": "pnpm --filter @incept/db exec tsx ../../scripts/roadmap-seed-fixtures.ts",
    "docs:check-import-cli": "pnpm --filter @incept/db exec node ../../scripts/docs-import-cli-check.mjs",
    "docs:check-markdown-like": "pnpm --filter @incept/db exec tsx ../../scripts/docs-markdown-like-check.mjs",
    "docs:check-media": "pnpm --filter @incept/db exec tsx ../../scripts/docs-media-check.mjs",
    "docs:check-code-highlighting": "pnpm --filter @incept/db exec tsx ../../scripts/docs-code-highlighting-check.mjs",
    "docs:archive": "pnpm --filter @incept/db exec tsx ../../scripts/docs-archive.mjs",
    "docs:cleanup-test-data": "pnpm --filter @incept/db exec tsx ../../scripts/docs-cleanup-test-data.mjs",
    "auth:revoke-owner-sessions": "pnpm --filter @incept/db exec tsx ../../scripts/auth-revoke-owner-sessions.mjs",
    "auth:grant": "pnpm --filter @incept/db exec tsx ../../scripts/auth-grant.mjs",
    "auth:owner": "pnpm --filter @incept/db exec tsx ../../scripts/auth-owner.mjs",
    "db:generate": "pnpm --filter @incept/db db:generate",
    "db:migrate": "pnpm --filter @incept/db db:migrate",
    "db:deploy": "pnpm --filter @incept/db db:deploy",
    "db:seed": "pnpm --filter @incept/db db:seed",
    "db:studio": "pnpm --filter @incept/db db:studio",
    "activity:check-github": "pnpm --filter @incept/db exec tsx ../../scripts/github-activity-check.mjs",
    "wt:new": "node scripts/worktree.mjs new",
    "wt:adopt": "node scripts/worktree.mjs adopt",
    "wt:status": "node scripts/worktree.mjs status",
    "wt:remove": "node scripts/worktree.mjs remove"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
