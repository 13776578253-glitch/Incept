{
  "name": "incept",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "docs:import": "pnpm --filter @incept/db exec tsx ../../scripts/docs-import.mjs",
    "docs:check-markdown-like": "pnpm --filter @incept/db exec tsx ../../scripts/docs-markdown-like-check.mjs",
    "docs:check-media": "pnpm --filter @incept/db exec tsx ../../scripts/docs-media-check.mjs",
    "docs:check-code-highlighting": "pnpm --filter @incept/db exec tsx ../../scripts/docs-code-highlighting-check.mjs",
    "docs:archive": "pnpm --filter @incept/db exec tsx ../../scripts/docs-archive.mjs",
    "docs:cleanup-test-data": "pnpm --filter @incept/db exec tsx ../../scripts/docs-cleanup-test-data.mjs",
    "auth:revoke-owner-sessions": "pnpm --filter @incept/db exec tsx ../../scripts/auth-revoke-owner-sessions.mjs",
    "auth:grant": "pnpm --filter @incept/db exec tsx ../../scripts/auth-grant.mjs",
    "db:generate": "pnpm --filter @incept/db db:generate",
    "db:migrate": "pnpm --filter @incept/db db:migrate",
    "db:deploy": "pnpm --filter @incept/db db:deploy",
    "db:seed": "pnpm --filter @incept/db db:seed",
    "db:studio": "pnpm --filter @incept/db db:studio"
  }
}

